# fry.local — the GPU box that carries MURRiX's fry and fry2 deployments. MCS serves both:
# they alternate, and the roots below are fry2's; switch FILES_PATH/VOLATILE_PATH/TMP_PATH
# to the fry profile's directories when fry is the one running. One GPU, one podman store:
# hold MURRiX's host lease (`make remote-lock HOST=fry` there) around build/run/stop.
REMOTE_HOST=fry.local
REMOTE_USER=mattias
REMOTE_DIR=/home/mattias/m/git/mcs

CONTAINER_NAME=mcs
IMAGE_NAME=mcs
MCS_PORT=8181
MCS_KEY=let-me-in
TZ=Europe/Stockholm

# The same host directories MURRiX's fry2 profile mounts (deploy/hosts/fry2.env there), mounted
# at the same container paths — /files, /old, /files-volatile, /files-tmp — so what MURRiX
# resolves is what MCS opens.
FILES_PATH=/home/mattias/m/fry2/files
OLD_PATH=/home/mattias/m3
VOLATILE_PATH=/home/mattias/m/fry2/files-volatile
TMP_PATH=/home/mattias/m/fry2/files-tmp

GPU=1
TORCH_CUDA=cu130
# The worker's RSS ceiling is 12g, but LOADING the VLM streams ~17 GB of unquantized
# safetensors through host memory before bitsandbytes puts 6.4 GB on the card: measured
# 2026-09-12, RSS peaked at 15.6 GB during the load and settled at 2.8 GB with the model
# resident. A 16g cap was one bad moment from an OOM kill mid-load, so the cap is sized to the
# load spike plus the front process and a few tesseract/ffmpeg children. MURRiX's own container
# holds ~0.7 GB now that the models are here (deploy/hosts/fry2.env there caps it at 12g).
#
# Raised to 24g with the transcodes (phase 3c, 2026-09-13): a CPU decode accumulates up to
# MCS_CPU_ENCODE_MAX_MB (4000 MB) per window, MURRiX runs two transcodes at once (its media pool
# gives each `cpu: 2` of five slots), and the worker may hold 12g — 8 + 12 + the front and the
# tool lane did not fit in 19g. MURRiX's own container went from 12g to 6g at the same time
# (deploy/hosts/fry2.env there); it holds ~0.7 GB.
MCS_MEMORY=24g
MCS_MODEL_MAX_RSS=12g
MCS_MODEL_PINNED=minilm
MCS_MODEL_IDLE_EVICT=86400
MCS_INSTRUCT_DEVICE=cpu
# The tool lane: how many exiftool/magick/ffmpeg/tesseract runs at once. Six cores, one thread
# per tool (MAGICK_THREAD_LIMIT / OMP_THREAD_LIMIT in the image), so one slot per core — the
# same width MURRiX's inline steps ran the same tools at before they moved here. Measured
# 2026-09-12 with the default 4: a crawl's OCR (`document-index` on every photo, up to six at
# once) and its renditions queued FIFO behind each other, and a five-size ladder that runs in
# ~1.5 s waited ~25 s for a slot, halving media-derive's throughput.
MCS_LIMIT_TOOLS=6
# The archive is a Swedish family's, with holiday clips in English and the odd wedding in
# Polish or Italian: not a pin (MCS_WHISPER_LANGUAGE would decode Las Vegas into Swedish) but
# the languages detection gives the benefit of the doubt, in order. Swedish first: whisper's
# Norwegian and Nynorsk guesses on Swedish speech go to it. Danish second, because the two
# Danish clips with speech on fry2 are Danish for real (a museum guide, 2026-09-13) and would
# otherwise come out as Swedish; a Swedish clip whisper calls Danish is the price, and none
# of the 1501 transcripts was one. The floor and the window count are the measured defaults
# (model_registry.py; MURRiX's work/tasks/done/media-whisper-detects-the-wrong-language.md).
MCS_WHISPER_LANGUAGES=sv,da
